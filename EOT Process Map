FLOWS.TradeUp = {
  label: "Trade Up",
  axes: [
    {key:"disposition", label:"Keep or Return?", options:[{v:"Keep",l:"Keep"},{v:"Return",l:"Return"}]},
    {key:"oldParty", label:"Original agreement is with", options:[{v:"Lender",l:"a Lender"},{v:"Internal",l:"Internal"}]},
    {key:"newParty", label:"New agreement is with", options:[{v:"Lender",l:"a Lender"},{v:"Internal",l:"Internal"}]},
  ],
  extra(){ return []; },
  pathLabel(state){
    return `Trade Up → ${state.disposition} (${state.oldParty} → ${state.newParty})`;
  },
  build(state){
    const oL = state.oldParty === "Lender", oI = state.oldParty === "Internal";
    const nL = state.newParty === "Lender", nI = state.newParty === "Internal";
    const K = state.disposition === "Keep", R = state.disposition === "Return";
    const steps = [];

    // 1. Quote request
    {
      let text = "";
      if(R){
        text += `- Sales receives the customer's 90-day notice of intent to return and forwards it to EOT\n- EOT forwards the intent to return to ${oL ? "the lender" : "the BU"}, reaches out to the BU to gauge interest in equipment repurchase, and offers the SEKO return option to the rep (getting a SEKO return quote if it's used)\n- Sales/customer approaches EOT for a quote\n`;
      } else {
        text += `- Sales/customer approaches EOT for a quote\n`;
      }
      text += `- EOT requests ${oL ? "a quote from the lender and buyout data from GA" : "buyout data from GA and verifies buyout amounts with BU Finance"}, reconciles the ${oL ? "lender" : "buyout"} quote, and asks Jake/Sam/Ivan to reconcile Receipts vs. Obligation vs. SAP items (Column K), contingent on balancing activity`;
      const step = {id:"quote-request", text, branches:[]};
      if(R && oL){
        step.branches.push({label:"Repurchase / RA", text:`- EOT requests a repurchase invoice if the BU elects to repurchase\n- EOT confirms with the lender what's needed for the Return Authorization\n     - DLL Caveat: DLL wants full payment before releasing return instructions\n- EOT confirms the lender, sales, and customer are aligned on the return date`});
      }
      steps.push(step);
    }

    // 2. Create quote task
    {
      const step = {id:"quote-task", text:`- EOT creates the Trade-Up quote task (full or partial) on the original agreement\n- Sales receives the reconciled quote`, branches:[]};
      if(R){
        step.branches.push({label:"SEKO Cost", text:"If SEKO is used, include the SEKO cost in the reconciled quote"});
      }
      steps.push(step);
    }

    // 3. New order ships
    {
      const newLabel = nL ? "lender" : "internal";
      const suffix = nL ? " on the lender customer account." : " on the internal funding account (rental or captive).";
      steps.push({id:"new-order", text:`- Front of House creates the new order and ships equipment\n- LCT bills AR to fund the new ${newLabel} agreement${suffix}`});
    }

    // 4. New agreement ships complete
    {
      const step = {id:"ships-complete", text:`- New agreement ships complete`, branches:[]};
      if(R){
        if(oL){
          step.branches.push({label:"Ready to Return", text:`- Sales rep/customer notifies EOT they're ready to return the original equipment\n- EOT reaches out to the lender for return instructions\n- Lender provides return instructions (internal use, not customer-facing)\n- EOT sends the customer-facing return instructions using the appropriate template`});
        } else {
          step.branches.push({label:"Ready to Return", text:`- Sales rep/customer notifies EOT they're ready to return the original equipment, and sends the customer-facing return instructions using the appropriate template`});
        }
      }
      steps.push(step);
    }

    // 5. Pending CTC
    steps.push({id:"pending-ctc", text:`- OE shifts the new agreement's Salesforce status to Pending CTC and assigns the task to an EOT specialist`});

    // 6. Updated quote & reconciliation
    steps.push({id:"updated-quote", text:`- EOT requests an updated quote from ${oL ? "the lender" : "GA"} and reconciles the ${R ? "current " : ""}quote against GA data`});

    // 7. Verify trade-up amount
    steps.push({id:"verify-amount", text:`- EOT verifies the trade-up amount against the original quote/FT saved in the new agreement's Salesforce files, saves the original and current trade-up quotes to the task, reassigns the Pending CTC task to a Jake/Sam/Ivan specialist, and adds the original agreement to the EOT/PMT checklist`});

    // 8. Reconcile & compile CTC
    {
      const step = {id:"compile-ctc", text:`- Jake/Sam/Ivan specialists reconcile the original agreement with the ${oL ? "DCF calculator" : "internal balance calculator"}, compile the CTC (original quote, current quote, calculator attached), work out the trade-up/CTC details (shortfunding vs. additional funding), and list the keying details needed for Cash App to complete upon funding`, branches:[]};
      if(R && oL){
        step.branches.push({label:"DLL Caveat", text:"DLL provides return instructions"});
      }
      steps.push(step);
    }

    // 9. Post CTC & fund
    {
      let text = `- Jake/Sam/Ivan specialists post the CTC to chatter on the new agreement, ccing Edwin Cook for keying details if needed\n- LCT issues a PO to the ${nL ? "lender" : "BU"}\n- If shortfunding, Cash App or Jake/Sam/Ivan keys the shortfunding from Misc Exp or ${oL ? "GL 140002" : "internal (rental/captive)"} to the ${nL ? "lender" : "internal"} customer account (funding acct)`;
      if(oL){
        text += ` — Jake/Sam/Ivan keys the reverse clawback for any remaining payments/renewals being shortfunded, and Cash App keys the rest`;
      }
      const step = {id:"post-ctc", text, branches:[]};
      if(oL){
        step.branches.push({label:"Shortfunding by PPT", text: R ? "IF shortfunding by PPT and FMV (in case of a partial trade-up), log the shortfund in the reimbursement tracker" : "IF shortfunding by PPT, log the shortfund in the reimbursement tracker"});
      }
      steps.push(step);
    }

    // 10. Fund transfer (depends on old+new party combo)
    {
      let text;
      if(oL && nL){
        text = `- OE forwards the funding request to the new lender`;
      } else if(oL && nI){
        text = `- Cash App debits the new rental/captive account and credits the old lender on the original agreement to key the payoff funds`;
      } else if(oI && nL){
        text = `- Cash App keys additional funding to the rental/captive account to pay off the original internal agreement`;
      } else { // oI && nI
        text = `- Cash App keys additional funding to the rental/captive account to pay off the original internal agreement (debit referencing the new agreement, credit referencing the original agreement)`;
      }
      steps.push({id:"fund-transfer", text});
    }

    // 11. New agreement commences
    {
      let text = `- New agreement commences`;
      const tail = [];
      if(R){
        tail.push("EOT confirms satisfactory completion of the equipment return");
      } else {
        tail.push("communicate to GA to stop invoicing new charges");
        if(nI && oL) tail.push("EOT communicates the Perfect Pay termination");
      }
      if(oL) tail.push("EOT gets the final due date from the lender");
      if(oI && R) tail.push("EOT provides the final due date to Jake/Sam/Ivan based on completion of the return");
      if(tail.length) text += `; ` + tail.join("; ");

      const step = {id:"commences", text, branches:[]};
      if(oL){
        step.branches.push({label:"Additional Collections", text:`IF additional collections are needed on the original agreement:\n      - Jake/Sam/Ivan forwards the outstanding amounts to EOT\n      - EOT compiles a buyout invoice and forwards it to sales, Great America, and Portfolio Administration\n      - An Additional Collections Needed task is created and reassigned to PA`});
      } else {
        step.branches.push({label:"Final Collections", text:`- Final customer collections are completed on the original agreement\n- Jake/Sam/Ivan outlines the outstanding amounts and requests (or verifies) any additional charges are opened by GA\n- EOT compiles the buyout invoice and forwards it to RFM/Portfolio Administration`});
      }
      if(R){
        step.branches.push({label:"Equipment Condition", text:`- If the equipment return is incomplete (missing/damaged):\n    - EOT or Jake/Sam/Ivan requests GA assess M4904 charges for missing/damaged equipment\n    - EOT includes the M4904 charge on the buyout invoice\n    - If SEKO handled the return, the charge is assessed under M4905 instead`});
      }
      steps.push(step);
    }

    // 12. Convergence checkpoint
    steps.push({id:"converge", text:`- New agreement commences AND any additional collections are completed` + (R ? ` AND the return is completed satisfactorily` : ``)});

    // 13. Update calculator & disposal instructions
    {
      const step = {id:"update-calc", text:"", branches:[]};
      if(oL){
        step.text = `- Jake/Sam/Ivan updates the DCF calculator and compiles disposal instructions`;
      } else {
        step.text = `- Jake/Sam/Ivan updates the internal agreement calculator, forwards it to Project Prizm for AR review, compiles disposal instructions, and terminates SAP billings via T-code VA42 (setting the contract end date to today)`;
        step.branches.push({label:"SAP Adjustment", text:"IF a SAP adjustment is needed, Project Prizm communicates it to BU Sales Ops"});
      }
      steps.push(step);
    }

    // 14. Close out
    {
      const step = {id:"close", text:`- Jake/Sam/Ivan closes out the trade-up: forwards disposal instructions to GA, communicates the final due date to ProCare (if needed), terminates the agreement in Salesforce, and moves it to the completed section of the EOT/Jake/Sam/Ivan checklist`, branches:[]};
      if(oL){
        step.branches.push({label:"Reimbursement Check", text:"Jake/Sam/Ivan confirms all open Misc Exp reimbursements are cleared at disposal"});
      }
      steps.push(step);
    }

    return steps;
  }
};

