let currentFlowKey = "Buyout";
let axisState = { disposition:"Keep", oldParty:"Lender", newParty:"Lender", dollarOut:false };

function escapeHtml(str){
  return String(str).replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]));
}

function renderCats(){
  const row = document.getElementById('catRow');
  row.innerHTML = "";
  Object.keys(FLOWS).forEach(key=>{
    const b = document.createElement('button');
    b.className = 'cat-btn' + (key===currentFlowKey ? ' active' : '');
    b.textContent = FLOWS[key].label;
    b.onclick = ()=>{ currentFlowKey = key; renderCats(); renderAxisPanel(); renderLedger(); };
    row.appendChild(b);
  });
}

function renderAxisPanel(){
  const flow = FLOWS[currentFlowKey];
  const panel = document.getElementById('axisPanel');
  panel.innerHTML = "";

  flow.axes.forEach(axis=>{
    const group = document.createElement('div');
    group.className = 'axis-group';
    const lbl = document.createElement('div');
    lbl.className = 'axis-label';
    lbl.textContent = axis.label;
    group.appendChild(lbl);
    const toggle = document.createElement('div');
    toggle.className = 'axis-toggle';
    axis.options.forEach(opt=>{
      const b = document.createElement('button');
      b.className = 'axis-btn' + (axisState[axis.key]===opt.v ? ' active' : '');
      b.textContent = opt.l;
      b.onclick = ()=>{ axisState[axis.key] = opt.v; renderAxisPanel(); renderLedger(); };
      toggle.appendChild(b);
    });
    group.appendChild(toggle);
    panel.appendChild(group);
  });

  const extras = flow.extra(axisState);
  extras.forEach(ex=>{
    if(ex.type === "checkbox"){
      const group = document.createElement('div');
      group.className = 'axis-group';
      const lbl = document.createElement('div');
      lbl.className = 'axis-label';
      lbl.textContent = "Special case";
      group.appendChild(lbl);
      const check = document.createElement('label');
      check.className = 'axis-check';
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.checked = !!axisState[ex.key] && ex.enabled;
      input.disabled = !ex.enabled;
      input.onchange = ()=>{ axisState[ex.key] = input.checked; renderLedger(); };
      check.appendChild(input);
      const span = document.createElement('span');
      span.textContent = ex.label;
      check.appendChild(span);
      group.appendChild(check);
      panel.appendChild(group);
    }
  });

  const pathBadge = document.createElement('div');
  pathBadge.className = 'flow-path';
  pathBadge.textContent = flow.pathLabel(axisState);
  panel.appendChild(pathBadge);
}

function renderBanner(){
  const area = document.getElementById('bannerArea');
  area.innerHTML = "";
  const notes = getFlaggedNotes(currentFlowKey, axisState);
  if(notes.length){
    const div = document.createElement('div');
    div.className = 'banner';
    div.innerHTML = '<b>Flagged by the team on this path</b><br>' + notes.map(n=>escapeHtml(n)).join('<br><br>');
    area.appendChild(div);
  }
}

let overrides = {};
let overridesLoaded = false;

function stateSig(){
  const flow = FLOWS[currentFlowKey];
  let parts = flow.axes.map(a=>`${a.key}=${axisState[a.key]}`);
  if(currentFlowKey === "Buyout") parts.push(`dollarOut=${!!axisState.dollarOut}`);
  return parts.join("|");
}

function overrideKey(stepId, branchIdx){
  const part = (branchIdx===null || branchIdx===undefined) ? "main" : ("b" + branchIdx);
  return `ovr:${currentFlowKey}:${stepId}:${part}:${stateSig()}`;
}

async function loadOverrides(){
  try{
    const result = await window.storage.list("ovr:", false);
    if(result && result.keys){
      for(const k of result.keys){
        try{
          const r = await window.storage.get(k, false);
          if(r) overrides[k] = r.value;
        }catch(e){ /* key may have been removed concurrently; skip */ }
      }
    }
  }catch(e){
    console.error("Couldn't load saved edits:", e);
  }
  overridesLoaded = true;
}

async function saveOverride(key, text){
  try{
    const result = await window.storage.set(key, text, false);
    if(!result){ console.error("Save failed for", key); return false; }
    overrides[key] = text;
    return true;
  }catch(e){
    console.error("Save error:", e);
    return false;
  }
}

async function resetOverride(key){
  try{
    await window.storage.delete(key, false);
  }catch(e){ /* already gone */ }
  delete overrides[key];
}

function makeEditableBlock(container, textClass, originalText, key){
  const isEdited = Object.prototype.hasOwnProperty.call(overrides, key);
  const displayText = isEdited ? overrides[key] : originalText;

  const p = document.createElement('p');
  p.className = textClass;
  p.innerHTML = escapeHtml(displayText) + (isEdited ? ' <span class="edited-tag">edited</span>' : '');
  container.appendChild(p);

  const toolbar = document.createElement('div');
  toolbar.className = 'edit-toolbar';
  const editLink = document.createElement('button');
  editLink.className = 'edit-link';
  editLink.textContent = 'Edit';
  toolbar.appendChild(editLink);
  let resetLink = null;
  if(isEdited){
    resetLink = document.createElement('button');
    resetLink.className = 'edit-link';
    resetLink.textContent = 'Reset to original';
    toolbar.appendChild(resetLink);
  }
  container.appendChild(toolbar);

  editLink.onclick = ()=>{
    const textarea = document.createElement('textarea');
    textarea.className = 'edit-textarea';
    textarea.value = displayText;
    const saveBtn = document.createElement('button');
    saveBtn.className = 'edit-save-btn';
    saveBtn.textContent = 'Save';
    const cancelBtn = document.createElement('button');
    cancelBtn.className = 'edit-cancel-btn';
    cancelBtn.textContent = 'Cancel';
    const btnRow = document.createElement('div');
    btnRow.className = 'edit-btn-row';
    btnRow.appendChild(saveBtn);
    btnRow.appendChild(cancelBtn);

    p.replaceWith(textarea);
    toolbar.replaceWith(btnRow);
    textarea.focus();

    saveBtn.onclick = async ()=>{
      saveBtn.disabled = true; saveBtn.textContent = 'Saving...';
      const ok = await saveOverride(key, textarea.value);
      if(ok){ renderLedger(); } else { saveBtn.disabled = false; saveBtn.textContent = 'Save'; }
    };
    cancelBtn.onclick = ()=>{ renderLedger(); };
  };

  if(resetLink){
    resetLink.onclick = async ()=>{
      await resetOverride(key);
      renderLedger();
    };
  }
}

function renderLedger(){
  if(!overridesLoaded){
    const area = document.getElementById('ledgerArea');
    area.innerHTML = '<div class="loading-note">Loading your saved edits...</div>';
    loadOverrides().then(renderLedger);
    return;
  }

  renderBanner();
  const flow = FLOWS[currentFlowKey];
  const steps = flow.build(axisState);
  const area = document.getElementById('ledgerArea');
  area.innerHTML = "";

  steps.forEach((step, idx)=>{
    const stepDiv = document.createElement('div');
    stepDiv.className = 'step';

    const numDiv = document.createElement('div');
    numDiv.className = 'step-num';
    numDiv.textContent = idx + 1;
    stepDiv.appendChild(numDiv);

    const body = document.createElement('div');
    body.className = 'step-body';

    makeEditableBlock(body, 'step-text', step.text, overrideKey(step.id, null));

    if(step.branches && step.branches.length){
      const bWrap = document.createElement('div');
      bWrap.className = 'branches';
      step.branches.forEach((b, bIdx)=>{
        const bd = document.createElement('div');
        bd.className = 'branch';
        const lblEl = document.createElement('span');
        lblEl.className = 'branch-label';
        lblEl.textContent = b.label;
        bd.appendChild(lblEl);
        makeEditableBlock(bd, 'branch-text', b.text, overrideKey(step.id, bIdx));
        bWrap.appendChild(bd);
      });
      body.appendChild(bWrap);
    }

    stepDiv.appendChild(body);
    area.appendChild(stepDiv);
  });
}


function renderGlossary(){
  const q = document.getElementById('gSearch').value.toLowerCase();
  const list = document.getElementById('gList');
  list.innerHTML = "";
  GLOSSARY.filter(g=>{
    return !q || g.term.toLowerCase().includes(q) || g.def.toLowerCase().includes(q);
  }).forEach(g=>{
    const item = document.createElement('div');
    item.className = 'g-item';
    let html = '<span class="g-term">' + escapeHtml(g.term) + '</span><p class="g-def">' + escapeHtml(g.def) + '</p>';
    if(g.analogy){
      html += '<p class="g-analogy">' + escapeHtml(g.analogy) + '</p>';
    }
    item.innerHTML = html;
    list.appendChild(item);
  });
}

function openGlossary(){
  document.getElementById('overlay').classList.add('show');
  document.getElementById('drawer').classList.add('show');
  renderGlossary();
}
function closeGlossary(){
  document.getElementById('overlay').classList.remove('show');
  document.getElementById('drawer').classList.remove('show');
}

function parseOverrideKey(key){
  // format: ovr:{flow}:{stepId}:{part}:{pathString}
  const rest = key.slice(4); // strip "ovr:"
  const c1 = rest.indexOf(':');
  const flow = rest.slice(0, c1);
  const rest2 = rest.slice(c1 + 1);
  const c2 = rest2.indexOf(':');
  const stepId = rest2.slice(0, c2);
  const rest3 = rest2.slice(c2 + 1);
  const c3 = rest3.indexOf(':');
  const part = rest3.slice(0, c3);
  const path = rest3.slice(c3 + 1);
  return {flow, stepId, part, path};
}

async function buildExportData(){
  const items = [];
  try{
    const result = await window.storage.list("ovr:", false);
    if(result && result.keys){
      for(const k of result.keys){
        try{
          const r = await window.storage.get(k, false);
          if(r){
            items.push({...parseOverrideKey(k), text: r.value});
          }
        }catch(e){ /* skip missing key */ }
      }
    }
  }catch(e){
    console.error("Couldn't load edits for export:", e);
  }
  return items;
}

async function openExport(){
  document.getElementById('exportOverlay').classList.add('show');
  document.getElementById('exportDrawer').classList.add('show');
  const content = document.getElementById('exportContent');
  content.innerHTML = '<div class="export-empty">Loading your edits...</div>';

  const items = await buildExportData();
  content.innerHTML = "";

  if(items.length === 0){
    content.innerHTML = '<div class="export-empty">No edits saved yet. Use the Edit link on any step, save a change, then come back here.</div>';
    return;
  }

  const countTag = document.createElement('div');
  countTag.className = 'export-count';
  countTag.textContent = items.length + (items.length === 1 ? ' edit found' : ' edits found');
  content.appendChild(countTag);

  const list = document.createElement('ul');
  list.className = 'export-item-list';
  items.forEach(it=>{
    const li = document.createElement('li');
    li.innerHTML = '<b>' + escapeHtml(it.flow) + ' \u2192 ' + escapeHtml(it.stepId) + '</b> (' + escapeHtml(it.part) + ') \u2014 ' + escapeHtml(it.path);
    list.appendChild(li);
  });
  content.appendChild(list);

  const textarea = document.createElement('textarea');
  textarea.className = 'export-textarea';
  textarea.readOnly = true;
  textarea.value = JSON.stringify(items, null, 2);
  content.appendChild(textarea);

  const copyBtn = document.createElement('button');
  copyBtn.className = 'export-copy-btn';
  copyBtn.textContent = 'Copy to Clipboard';
  copyBtn.onclick = async ()=>{
    try{
      await navigator.clipboard.writeText(textarea.value);
    }catch(e){
      textarea.select();
      try{ document.execCommand('copy'); }catch(e2){ /* clipboard unavailable */ }
    }
    copyBtn.textContent = 'Copied!';
    copyBtn.classList.add('copied');
    setTimeout(()=>{ copyBtn.textContent = 'Copy to Clipboard'; copyBtn.classList.remove('copied'); }, 2000);
  };
  content.appendChild(copyBtn);
}

function closeExport(){
  document.getElementById('exportOverlay').classList.remove('show');
  document.getElementById('exportDrawer').classList.remove('show');
}

renderCats();
renderAxisPanel();
renderLedger();
